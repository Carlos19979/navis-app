<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without aps-environment the OS never
	     hands the app an APNs token, so FirebaseMessaging.getToken() resolves
	     to null with no error and every push silently disappears.

	     `development` is the sandbox APNs environment used by debug/profile
	     builds and by TestFlight-through-Xcode runs. Xcode's automatic signing
	     rewrites it to `production` when exporting an App Store / TestFlight
	     archive with a distribution profile — do NOT hardcode `production`
	     here or local device runs stop getting tokens. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
